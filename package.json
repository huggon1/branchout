{
  "name": "feedloom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal desktop collection and Feed workspace",
  "main": "dist/main/main.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --import tsx --test tests/*.test.mjs tests/*.test.ts",
    "check:docs": "node scripts/check-docs.mjs",
    "check": "npm test && npm run typecheck && npm run build && npm run check:docs && git diff --check",
    "probe:github": "node scripts/probe-github.mjs",
    "probe:model": "node scripts/with-system-proxy.mjs node scripts/probe-model.mjs",
    "probe:desktop": "electron src/desktop/probe.cjs --model",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs && vite build",
    "start": "npm run build && electron .",
    "prepare:runtime": "node scripts/with-system-proxy.mjs node scripts/prepare-runtime.mjs",
    "package:app": "npm run build && node scripts/with-system-proxy.mjs electron-packager . Feedloom --platform=darwin --arch=arm64 --out=build --overwrite --extra-resource=.runtime --ignore=\"^/(tests|test-results|playwright-report|docs|scripts|src|build|\\.runtime|\\.git)\"",
    "test:desktop": "npm run build && node --import tsx tests/e2e/desktop.mjs",
    "verify:live": "npm run build && node scripts/verify-live.mjs",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "cheerio": "1.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "undici": "8.9.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.1",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "@vitejs/plugin-react": "4.5.0",
    "electron": "44.3.0",
    "esbuild": "0.28.1",
    "prettier": "3.6.2",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  }
}
