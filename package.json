{
  "name": "branchout",
  "version": "0.4.0",
  "license": "MIT",
  "private": true,
  "main": "dist/main/main.cjs",
  "scripts": {
    "build": "node scripts/app-build/app.mjs",
    "setup:x": "node scripts/app-build/with-env-proxy.mjs scripts/app-build/prepare-x-runtime.mjs",
    "setup:xhs": "node scripts/app-build/with-env-proxy.mjs scripts/app-build/prepare-xhs-runtime.mjs",
    "prepare:runtime": "npm run setup:x && npm run setup:xhs",
    "build:icon": "node scripts/app-build/icon.mjs",
    "package:app": "npm run build && npm run build:icon && electron-builder --mac --arm64 --publish never",
    "dev": "npm run build && electron .",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.87.1",
    "@earendil-works/pi-ai": "^0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@phosphor-icons/react": "^2.1.10",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "parse5": "^8.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typebox": "^1.3.27",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "44.4.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.8",
    "sharp": "^0.35.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "type": "module",
  "description": "Relate collected content to the projects you are building",
  "engines": {
    "node": ">=24.0.0"
  }
}
